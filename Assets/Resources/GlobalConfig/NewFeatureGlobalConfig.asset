%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3918d635e1b41140a4404c502af381b, type: 3}
  m_Name: NewFeatureGlobalConfig
  m_EditorClassIdentifier: Assembly-CSharp::NewFeatureGlobalConfig
  <NewFeatureDatas>k__BackingField:
  - FeatureName: Hidden Fish
    FeatureDes: Tap a mystery fish to find out what it really is.
    FeatureType: 1
    FeatureIcon: {fileID: 21300000, guid: 60119e73abf246a7ba85462bfc126e55, type: 3}
  - FeatureName: Smoke Bubble
    FeatureDes: Let it float to the surface to clear the smoke.
    FeatureType: 2
    FeatureIcon: {fileID: 21300000, guid: 7115dd6af8579784ab37545f690fe3c7, type: 3}
  - FeatureName: Spawner Bubble
    FeatureDes: Take a fish out and the spawner sends in the next one.
    FeatureType: 3
    FeatureIcon: {fileID: 21300000, guid: c4fb29505453462f8875c7da538abbe8, type: 3}
  - FeatureName: Lock & Key
    FeatureDes: Pop the key bubble to open the locked bubble.
    FeatureType: 4
    FeatureIcon: {fileID: 21300000, guid: 60ade620b0984fbf8849dc54240198a8, type: 3}
  - FeatureName: Frozen Bubble
    FeatureDes: Complete a tank to melt one layer. The number shows how many are left.
    FeatureType: 5
    FeatureIcon: {fileID: 21300000, guid: 9e740c18e403443e829639b5e513a327, type: 3}
  - FeatureName: Pearl
    FeatureDes: A pearl just takes up space, no fish inside.
    FeatureType: 6
    FeatureIcon: {fileID: 21300000, guid: 9092a364da5c4324393b4f032b5e4bd5, type: 3}
  - FeatureName: Layered Bubble
    FeatureDes: Clear all the fish to reveal the next layer.
    FeatureType: 7
    FeatureIcon: {fileID: 21300000, guid: 8ac230ce0e914c8daf32c2ecc6b8c548, type: 3}
  - FeatureName: Fish School
    FeatureDes: Tap one fish and the whole school follows.
    FeatureType: 8
    FeatureIcon: {fileID: 21300000, guid: 83a0fd2906704993893b04483f0a1704, type: 3}
  - FeatureName: Order Bubble
    FeatureDes: Complete a tank of the fish shown to unlock it.
    FeatureType: 9
    FeatureIcon: {fileID: 21300000, guid: 996573c7f2c14fc88473b510cc3057bf, type: 3}
